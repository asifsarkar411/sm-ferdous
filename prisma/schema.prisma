generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id       String @id @default(auto()) @map("_id") @db.ObjectId
  email    String @unique
  password String
}

model Hero {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  subtitle    String
  description String?
  cvUrl       String?
  imageUrl    String?
}

model About {
  id            String  @id @default(auto()) @map("_id") @db.ObjectId
  description   String
  yearsCoding   String?
  projectsBuilt String?
  frameworks    String?
  imageUrl      String?
}

model Education {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  degree      String
  institution String
  year        String
  gpa         String?
}

model Journey {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  subtitle    String
  date        String
  location    String
  points      String[]
  category    String?
  order       Int      @default(0)
}

model Skill {
  id       String  @id @default(auto()) @map("_id") @db.ObjectId
  name     String
  category String
  icon     String?
}

model Project {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  category    String
  description String
  imageUrl    String?
  liveUrl     String?
}

model Contact {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  motto       String?
  address     String?
  location    String?
  phoneNumber String?
  title       String?
  description String?
  buttonText  String?
  buttonLink  String?
}

model Message {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  email     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}
