generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id       String @id @default(auto()) @map("_id") @db.ObjectId
  email    String @unique
  password String
}

model Hero {
  id       String  @id @default(auto()) @map("_id") @db.ObjectId
  title    String
  subtitle String
  imageUrl String?
}

model About {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  description String
  imageUrl    String?
}

model Service {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  description String
  iconUrl     String?
}

model Testimonial {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  role      String
  quote     String
  avatarUrl String?
}

model Contact {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  description String
  buttonText  String
  buttonLink  String
}
