generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       String @id @default(uuid())
  email    String @unique
  password String
}

model Hero {
  id              String   @id @default(uuid())
  title           String
  subtitle        String
  description     String?
  cvUrl           String?
  imageUrl        String?
  logoName        String?
  logoImage       String?
  isAvailable     Boolean? @default(true)
  statusText      String?  @default("Available for new projects")
  showStatusBadge Boolean? @default(true)
}

model About {
  id            String  @id @default(uuid())
  description   String
  yearsCoding   String?
  projectsBuilt String?
  frameworks    String?
  imageUrl      String?
}

model Education {
  id          String  @id @default(uuid())
  degree      String
  institution String
  year        String
  gpa         String?
}

model Journey {
  id          String   @id @default(uuid())
  title       String
  subtitle    String
  date        String
  location    String
  points Json
  category    String?
  order       Int      @default(0)
}

model Skill {
  id       String  @id @default(uuid())
  name     String
  category String
  icon     String?
}

model Project {
  id          String  @id @default(uuid())
  title       String
  category    String
  description String
  imageUrl    String?
  liveUrl     String?
  detailsUrl  String?
}

model Contact {
  id          String  @id @default(uuid())
  motto       String?
  address     String?
  location    String?
  phoneNumber String?
  title       String?
  description String?
  buttonText  String?
  buttonLink  String?
}

model Message {
  id        String   @id @default(uuid())
  name      String
  email     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model CV {
  id        String   @id @default(uuid())
  title     String
  fileUrl   String
  isHidden  Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Hobby {
  id          String   @id @default(uuid())
  title       String
  description String?
  imageUrl    String?
}

model LanguageProficiency {
  id       String @id @default(uuid())
  language String
  reading  String
  writing  String
  speaking String
}

model Service {
  id          String   @id @default(uuid())
  title       String
  description String
  createdAt   DateTime @default(now())
}


